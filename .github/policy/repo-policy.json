{
  "manifest_review": {
    "label": "manifest-review:approved",
    "approvers": [
      "markusleben"
    ],
    "manifest_sensitive_files": [
      "package.json",
      "package-lock.json",
      "nova/package.json",
      "nova/package-lock.json"
    ]
  },
  "dependabot_safe_lane": {
    "label": "dependabot-safe:auto-merge",
    "allowed_package_ecosystems": [
      "npm",
      "npm_and_yarn"
    ],
    "dependency_group": "npm-dev-minor-patch",
    "allowed_update_types": [
      "version-update:semver-minor",
      "version-update:semver-patch"
    ],
    "manual_review_dependencies": [
      "vitest",
      "vite",
      "typescript",
      "tsx",
      "rollup",
      "rolldown",
      "esbuild"
    ],
    "github_actions": {
      "dependency_group": "github-actions-minor-patch",
      "allowed_update_types": [
        "version-update:semver-minor",
        "version-update:semver-patch"
      ],
      "workflow_file_prefix": ".github/workflows/"
    }
  },
  "main_branch_protection": {
    "required_status_checks": [
      "analyze",
      "ci-gate",
      "dependency-review",
      "manifest-review-gate",
      "readme-release-gate"
    ],
    "required_status_check_apps": {},
    "advisory_checks": [
      "codex-review-gate"
    ],
    "required_approving_review_count": 1,
    "require_code_owner_reviews": true,
    "dismiss_stale_reviews": true,
    "required_conversation_resolution": true,
    "strict_required_status_checks": true
  },
  "production_environment": {
    "name": "production",
    "deployment_branch_policy": {
      "protected_branches": false,
      "custom_branch_policies": true
    },
    "deployment_branch_policies": [
      {
        "name": "main",
        "type": "branch"
      },
      {
        "name": "v*",
        "type": "tag"
      }
    ],
    "protection_rule_types": [
      "branch_policy"
    ]
  },
  "cloud_source_gate": {
    "check_name": "cloud-source-gate",
    "reporter_app_slug": "markusleben-ha-nova-cloud-source-gate",
    "reporter_app_id": 0,
    "synchronous_invalidator_check_name": "cloud-source-invalidator",
    "synchronous_invalidator_app_slug": "markusleben-ha-nova-cloud-source-invalidator",
    "synchronous_invalidator_app_id": 0,
    "sensitive_workflows": [
      ".github/workflows/cloud-source-gate.yml",
      ".github/workflows/ci.yml",
      ".github/workflows/release.yml",
      ".github/workflows/release-candidate.yml"
    ]
  },
  "release_tag_protection": {
    "name": "release-tags-protection",
    "ref_include": "refs/tags/v*",
    "required_rules": [
      "creation",
      "update",
      "deletion"
    ],
    "forbidden_bypass_actor_types": [
      "Integration",
      "DeployKey"
    ],
    "maintainer_bypass_actor_types": [
      "RepositoryRole",
      "Team",
      "OrganizationAdmin"
    ],
    "rationale": "The 'creation' rule blocks the Actions token from minting v* tags, so release tags are maintainer-pushed and the RC workflow never auto-publishes. verify-release-pipeline.sh fails if a non-human automation actor (Integration/GitHub App or DeployKey) can bypass \u2014 that would re-enable the broken auto-publish path \u2014 and also fails if no human maintainer role (RepositoryRole/Team/OrganizationAdmin) can bypass, since then nobody could push the release tag and the tag-first flow would break."
  },
  "readme_release_gate": {
    "label": "readme-stable:approved",
    "approvers": [
      "markusleben"
    ],
    "release_prep_files": [
      "version.json"
    ]
  }
}
